# CẤU HÌNH KẾT NỐI CSDL MICROSOFT SQL SERVER
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
SQLSERVER_SERVER=localhost
SQLSERVER_DATABASE=QuanLyBaiDoXe

# Xác thực kết nối:
# - Nếu dùng Windows Authentication: đặt SQLSERVER_TRUSTED_CONNECTION=yes
# - Nếu dùng SQL Server Authentication (sa): đặt SQLSERVER_TRUSTED_CONNECTION=no
SQLSERVER_TRUSTED_CONNECTION=yes
SQLSERVER_USERNAME=sa
SQLSERVER_PASSWORD=your_password_here

# Cho phép chạy nạp lại full script SQL từ route /setup trên web (0: Tắt, 1: Bật)
ALLOW_RUN_FULL_SCRIPT=1

# Cổng khởi chạy ứng dụng Flask
PORT=5000
